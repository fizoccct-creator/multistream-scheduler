{
  "name": "multistream-scheduler",
  "productName": "Multistream Scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Schedule a pre-recorded video to go live on YouTube, Facebook, Instagram and TikTok at the same time.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fizoccct-creator/multistream-scheduler.git"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server-only": "node server.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.multistream.scheduler",
    "productName": "Multistream Scheduler",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "identity": null
    },
    "dmg": {
      "artifactName": "Multistream-Scheduler-Mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Multistream-Scheduler-Windows-Setup.${ext}"
    },
    "publish": null,
    "afterPack": "build/adhoc-sign.cjs"
  }
}
